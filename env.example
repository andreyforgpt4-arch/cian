CIAN_AD_URL=https://novosibirsk.cian.ru/sale/suburban/310020183/
CIAN_MESSAGE=Здравствуйте! Подскажите, пожалуйста, актуально ли объявление?
# Optional (preferred for long/multiline texts):
# CIAN_MESSAGE_FILE=message.txt
GOOGLE_DRIVE_FILE_ID=1lkagZuT2M2y1MjnPdNTNOQ_LgMXT0ZVu

# Where to store authenticated cookies/localStorage after manual login:
STORAGE_STATE_PATH=auth_state.json
STATE_DB_PATH=state.db

# Optional: origin/referer for Cian API calls (sometimes region subdomain matters)
# CIAN_ORIGIN=https://novosibirsk.cian.ru
# CIAN_REFERER=https://novosibirsk.cian.ru/

# Step 2 (photo analysis)
# OPENAI_API_KEY=...
# OPENAI_VISION_MODEL=gpt-4o-mini
# OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses

# Step 2 alternative: n8n webhook scoring (preferred if OpenAI is blocked)
# PHOTO_SCORING_WEBHOOK_URL=https://n8n.tendergrad.com/webhook/photo_skoring
# PHOTO_SCORING_WEBHOOK_TOKEN=... (optional)
# PHOTO_SCORING_TIMEOUT_S=300
# photo_skoring receives URL payload:
# { offer_id, photo_index, photo_url }

# Step 3 (collage + upload + message generation) via n8n
# CREATE_PHOTO_WEBHOOK_URL=https://n8n.tendergrad.com/webhook/create_photo
# CREATE_PHOTO_WEBHOOK_TOKEN=... (optional)
# CREATE_PHOTO_TIMEOUT_S=300
# create_photo receives base64 for the selected photo:
# selected_photo: { image_base64, image_mime, photo_url, ... }

# Debug (optional)
HEADLESS=false
SLOW_MO_MS=0
DEBUG_PAUSE=false
CAPTCHA_PAUSE=true

# Automatic CAPTCHA solving (optional, requires API key from service)
# Set CAPTCHA_SOLVER_SERVICE to "2captcha" or "capsolver" to enable auto-solving
# If not set or API key missing, falls back to manual solving (CAPTCHA_PAUSE)
# CAPTCHA_SOLVER_SERVICE=2captcha
# CAPTCHA_SOLVER_API_KEY=your_api_key_here
# Get API keys:
# - 2captcha: https://2captcha.com/?from=1234567 (from=1234567 is optional referral)
# - CapSolver: https://capsolver.com/ (usually cheaper and faster)

